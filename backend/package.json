{
  "name": "@kitty/backend",
  "private": true,
  "type": "module",
  "description": "Kitty's small, untrusted backend: indexer, public API (tree, parties, House Fund, backups, pages), fee relay, faucet and the Butler",
  "scripts": {
    "api": "tsx src/api/main.ts",
    "indexer": "tsx src/indexer/main.ts",
    "butler": "tsx src/butler/main.ts",
    "dev": "tsx src/all.ts",
    "db:generate": "drizzle-kit generate",
    "setup:devnet": "tsx scripts/setup-devnet.ts",
    "sim": "tsx sim/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^2.1.3",
    "@kitty/chain": "link:../frontend/packages/chain",
    "@kitty/sdk": "link:../frontend/packages/sdk",
    "@kitty/zk": "link:../frontend/packages/zk",
    "@noble/curves": "^2",
    "@noble/hashes": "^2",
    "@solana-program/compute-budget": "^0.12.0",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.16.0",
    "@solana/kit": "^8.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "snarkjs": "0.7.6",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
