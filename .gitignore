# OS and editor files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
.idea/
# Claude Code local settings (shared settings.json can still be committed)
.claude/settings.local.json

# ---------------------------------------------------------------
# Fonts: the ITF Free Font License forbids redistribution.
# Fetched at install by `pnpm fonts` (frontend/scripts/fetch-fonts.mjs).
# ---------------------------------------------------------------
frontend/packages/ui/fonts/Boska-*.woff2
frontend/packages/ui/fonts/Switzer-*.woff2

# ---------------------------------------------------------------
# Project docs and reference material (kept local only)
# ---------------------------------------------------------------
/docs/
# Screenshots, frame sheets and walkthrough videos from the review loop
/frontend/review/
# Raw painted art (65 MB). pnpm art turns it into apps/web/public/art, which is committed
/frontend/kitty visuals/
